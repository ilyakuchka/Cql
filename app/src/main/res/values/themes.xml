<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Страницы приложения светлые (тёмные экраны рисует сам Compose), поэтому родитель — светлая
        стандартная тема Android. Для Android 9 и ниже (атрибута forceDarkAllowed там нет) это единственный
        сигнал для системной/MIUI-тёмной темы не перекрашивать приложение.
    -->
    <style name="Theme.Unofficial" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
